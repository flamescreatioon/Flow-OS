# flowOS Root Environment Variables
# Used by Docker Compose for local development infrastructure provisioning.
# Copy this file to .env: `cp .env.example .env`
# Note: Applications running on the host machine consume their own env files:
#   - API (Laravel): apps/api/.env
#   - Web (Next.js): apps/web/.env.local

# -----------------------------------------------------------------------------
# PostgreSQL Container Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=flowos
POSTGRES_USER=flowos
POSTGRES_PASSWORD=flowos_local
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis Container Configuration
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Optional Tooling (Mailpit)
# -----------------------------------------------------------------------------
MAILPIT_PORT=1025
MAILPIT_DASHBOARD_PORT=8025

# -----------------------------------------------------------------------------
# Application Reference URLs (Host Development)
# -----------------------------------------------------------------------------
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1