APP_NAME=flowOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ORGANIZATION_INVITATION_LIFETIME_HOURS=168

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# For host execution (php artisan serve): use 127.0.0.1
# If executed inside Docker Compose: use 'postgres'
# Credentials must match root .env / POSTGRES_* settings
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flowos
DB_USERNAME=flowos
DB_PASSWORD=flowos_local

# SQLite is used by the fast test suite only. It never shares the PostgreSQL
# database name, so it cannot open a file next to the application by accident.
DB_SQLITE_DATABASE=:memory:

# -----------------------------------------------------------------------------
# Redis (Cache, Queue, Sessions)
# For host execution: use 127.0.0.1
# If executed inside Docker Compose: use 'redis'
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Mail (Mailpit)
# For host execution: use 127.0.0.1 (port 1025)
# If executed inside Docker Compose: use 'mailpit'
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@flowos.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Local development origins only. Set explicit HTTPS production origins via
# deployment secrets/configuration; never use '*' with credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
