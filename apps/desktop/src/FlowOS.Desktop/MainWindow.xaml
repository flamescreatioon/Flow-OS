<Window x:Class="FlowOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="flowOS" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="flowOS" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="Business Operating System for Nigerian Businesses"
                           FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="1" Padding="40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🏪" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="flowOS Desktop" FontSize="32" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,20,0,10"/>
                <TextBlock Text="Ready for offline-first business operations"
                           FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Point of Sale" Width="180" Height="45" Margin="10"
                            FontSize="14" FontWeight="Medium"/>
                    <Button Content="Inventory" Width="180" Height="45" Margin="10"
                            FontSize="14" FontWeight="Medium"/>
                    <Button Content="Reports" Width="180" Height="45" Margin="10"
                            FontSize="14" FontWeight="Medium"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
